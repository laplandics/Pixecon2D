  m_text: "\u0423\u0447\u0438\u043C \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u043E\u043C\u0443,
    \u043D\u0435\u043C\u0435\u0446\u043A\u043E\u043C\u0443, \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u043E\u043C\u0443, 
    \u0438\u0441\u043F\u0430\u043D\u0441\u043A\u043E\u043C\u0443, \u0438\u0442\u0430\u043B\u044C\u044F\u043D\u0441\u043A\u043E\u043C\u0443
    \u0438 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C\u0443, \u0430\u0440\u0430\u0431\u0441\u043A\u043E\u043C\u0443
    \u0438 \u0440\u0443\u0441\u0441\u043A\u043E\u043C\u0443, \u043A\u0430\u043A \u0438\u043D\u043E\u0441\u0442\u0440\u0430\u043D\u043D\u043E\u043C\u0443
    \u044F\u0437\u044B\u043A\u0430\u043C!"
