  m_text: "1. \u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u043B\u0435\u043A\u0441\u0438\u043A\u0443 \u043A \u043F\u043E\u0432\u0442\u043E\u0440\u0435\u043D\u0438\u044E
    \u043D\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435 \u0441 \u0412\u0430\u0448\u0438\u043C\u0438
    \u0441\u043B\u043E\u0432\u0430\u0440\u044F\u043C\u0438\n\n2. \u0412\u0441\u0435
    \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0435 \u0441\u043B\u043E\u0432\u0430\u0440\u0438
    \u043F\u043E\u044F\u0432\u044F\u0442\u0441\u044F \u0432 \u0438\u0433\u0440\u0435,
    \u043A\u043E\u0433\u0434\u0430 \u0432\u044B \u043D\u0430\u0436\u043C\u0435\u0442\u0435
    \u043A\u043D\u043E\u043F\u043A\u0443 \"\u041D\u0410\u0427\u0410\u0422\u042C\"\n\n3.
    \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0435 \u0441\u043B\u043E\u0432\u0430\u0440\u0438
    \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F \u043F\u043E\u0441\u043B\u0435
    \u0432\u044B\u0445\u043E\u0434\u0430 \u0438\u0437 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F,
    \u0412\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
    \u043F\u043E\u0432\u0442\u043E\u0440\u0435\u043D\u0438\u0435 \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C"
